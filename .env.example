# Copy to .env; never commit secrets. Empty values use safe development defaults.
APP_ENV=
# Explicit true for loopback development only; prohibited in production.
DEV_AUTH_BYPASS=
BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Full private HTTPS URL; backend only. Do not paste into logs or frontend.
USOS_ICAL_URL=
PUBLIC_APP_URL=
DATABASE_URL=
